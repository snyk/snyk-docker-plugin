{
  "name": "snyk-docker-plugin",
  "description": "Snyk CLI docker plugin",
  "author": "snyk.io",
  "license": "Apache-2.0",
  "homepage": "https://github.com/snyk/snyk-docker-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/snyk/snyk-docker-plugin"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "scripts": {
    "build": "tsc",
    "build-watch": "tsc -w",
    "debug": "tsc-watch --project tsconfig.json --onSuccess 'node --inspect --inspect-brk .'",
    "lint": "run-p --max-parallel=${JOBS:-5} --aggregate-output lint:*",
    "lint:prettier": "prettier --check \"{lib,test}/**/*.ts\"",
    "lint:eslint": "eslint \"{lib,test}/**/*.ts\"",
    "lint:commit": "commitlint --from=HEAD~1",
    "format": "prettier --loglevel warn --write '{lib,test}/**/*.ts' && eslint --fix '{lib,test}/**/*.ts'",
    "test": "jest --logHeapUsage --colors --selectProjects unit system",
    "test:unit": "jest --logHeapUsage --colors --selectProjects unit",
    "test:system": "jest --logHeapUsage --colors --selectProjects system",
    "test:windows": "jest --logHeapUsage --colors --selectProjects windows",
    "test:windows:docker": "jest --logHeapUsage --colors --selectProjects windows-docker",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@snyk/composer-lockfile-parser": "^1.5.0",
    "@snyk/dep-graph": "^2.16.11",
    "@snyk/docker-registry-v2-client": "^4.0.6",
    "@snyk/rpm-parser": "^3.4.3",
    "@snyk/snyk-docker-pull": "^3.17.2",
    "@swimlane/docker-reference": "^2.0.1",
    "adm-zip": "^0.6.1",
    "chalk": "^2.4.2",
    "debug": "^4.4.3",
    "docker-modem": "^3.0.8",
    "dockerfile-ast": "^0.7.1",
    "elfy": "^1.0.0",
    "event-loop-spinner": "^2.3.3",
    "fzstd": "^0.1.1",
    "gunzip-maybe": "^1.4.2",
    "minimatch": "^9.0.9",
    "packageurl-js": "1.2.0",
    "semver": "^7.8.6",
    "shescape": "^2.1.15",
    "snyk-nodejs-lockfile-parser": "^2.10.3",
    "snyk-poetry-lockfile-parser": "1.10.1",
    "snyk-resolve-deps": "^4.10.2",
    "tar-stream": "^2.2.0",
    "tslib": "^1",
    "varint": "^6.0.0"
  },
  "overrides": {
    "brace-expansion@^2": "^2.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@eslint/js": "^10.0.1",
    "@mongodb-js/zstd": "^2.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/adm-zip": "^0.6.0",
    "@types/debug": "^4.1.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/tar-stream": "^1.6.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-watch": "^4.2.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "./scripts/update-version.sh ${nextRelease.version}"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
